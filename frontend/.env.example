# ============================================
# Variables d'environnement Frontend - TopBudget
# ============================================
# Copiez ce fichier vers .env.local et adaptez les valeurs à votre environnement

# ============================================
# ENVIRONNEMENT NEXT.JS
# ============================================
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# ============================================
# API BACKEND
# ============================================
# URL de base de l'API backend
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Alternative pour la production
# NEXT_PUBLIC_API_URL=https://api.topbudget.com/api

# Timeout des requêtes API (en millisecondes)
NEXT_PUBLIC_API_TIMEOUT=30000

# ============================================
# AUTHENTIFICATION
# ============================================
# URL de redirection après login
NEXT_PUBLIC_LOGIN_REDIRECT_URL=/dashboard

# URL de redirection après logout
NEXT_PUBLIC_LOGOUT_REDIRECT_URL=/

# Durée de vie des tokens en localStorage (en millisecondes)
NEXT_PUBLIC_TOKEN_REFRESH_INTERVAL=300000

# ============================================
# CONFIGURATION SWR
# ============================================
# Intervalle de revalidation SWR (en millisecondes)
NEXT_PUBLIC_SWR_REVALIDATE_INTERVAL=30000

# Timeout SWR
NEXT_PUBLIC_SWR_TIMEOUT=10000

# ============================================
# UPLOADS ET FICHIERS
# ============================================
# Taille maximale des fichiers uploadés (en MB)
NEXT_PUBLIC_MAX_FILE_SIZE=5

# Types de fichiers autorisés pour l'avatar
NEXT_PUBLIC_ALLOWED_AVATAR_TYPES=jpg,jpeg,png,gif

# URL de base pour les fichiers uploadés
NEXT_PUBLIC_UPLOAD_URL=http://localhost:5001/uploads

# ============================================
# INTERNATIONALISATION
# ============================================
# Langue par défaut
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# Langues supportées (séparées par des virgules)
NEXT_PUBLIC_LOCALES=fr,en

# ============================================
# ANALYTICS ET MONITORING
# ============================================
# Google Analytics (optionnel)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry pour le monitoring frontend (optionnel)
NEXT_PUBLIC_SENTRY_DSN=

# Hotjar pour l'analyse utilisateur (optionnel)
NEXT_PUBLIC_HOTJAR_ID=

# ============================================
# PWA ET SERVICE WORKER
# ============================================
# Activation du service worker
NEXT_PUBLIC_PWA_ENABLED=true

# Cache strategy pour PWA
NEXT_PUBLIC_PWA_CACHE_STRATEGY=CacheFirst

# ============================================
# DÉVELOPPEMENT
# ============================================
# Port du serveur de développement
PORT=3000

# Host du serveur de développement
HOST=0.0.0.0

# ============================================
# BUILD ET DÉPLOIEMENT
# ============================================
# URL de base de l'application en production
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# CDN pour les assets statiques (optionnel)
NEXT_PUBLIC_CDN_URL=

# ============================================
# SÉCURITÉ
# ============================================
# Content Security Policy (CSP) - activation
NEXT_PUBLIC_CSP_ENABLED=false

# Nonce pour les scripts inline (généré automatiquement)
# NEXT_PUBLIC_CSP_NONCE=

# ============================================
# FONCTIONNALITÉS MÉTIER
# ============================================
# Devise par défaut
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR

# Symboles de devises supportées
NEXT_PUBLIC_SUPPORTED_CURRENCIES=EUR,USD,CHF,GBP

# Format de date par défaut
NEXT_PUBLIC_DATE_FORMAT=DD/MM/YYYY

# Format de nombre par défaut (décimales)
NEXT_PUBLIC_NUMBER_DECIMALS=2

# ============================================
# THÈME ET UI
# ============================================
# Thème par défaut (light/dark/system)
NEXT_PUBLIC_DEFAULT_THEME=system

# Couleur primaire par défaut
NEXT_PUBLIC_PRIMARY_COLOR=#3B82F6

# ============================================
# CACHE ET PERFORMANCES
# ============================================
# Durée de cache pour les requêtes statiques (en secondes)
NEXT_PUBLIC_STATIC_CACHE_DURATION=3600

# Activation du cache des images
NEXT_PUBLIC_IMAGE_CACHE_ENABLED=true

# ============================================
# VARIABLES SPÉCIFIQUES À L'ENVIRONNEMENT
# ============================================

# DÉVELOPPEMENT
# NODE_ENV=development
# NEXT_PUBLIC_API_URL=http://localhost:5001/api
# NEXT_PUBLIC_BASE_URL=http://localhost:3000

# PRODUCTION
# NODE_ENV=production
# NEXT_PUBLIC_API_URL=https://api.topbudget.com/api
# NEXT_PUBLIC_BASE_URL=https://topbudget.com

# TEST
# NODE_ENV=test
# NEXT_PUBLIC_API_URL=http://localhost:5001/api
# NEXT_PUBLIC_BASE_URL=http://localhost:3000