# ============================================
# TopBudget - Variables d'environnement
# ============================================
# Copiez ce fichier vers .env et adaptez les valeurs selon votre environnement
# 
# Pour le développement local, utilisez les valeurs par défaut
# Pour la production, utilisez Docker secrets pour les données sensibles

# ============================================
# Sélection de l'environnement
# ============================================
# Décommentez la ligne correspondante à votre environnement :

# Développement local (par défaut)
NODE_ENV=development

# Production
# NODE_ENV=production

# Tests
# NODE_ENV=test

# ============================================
# Configuration de base (tous environnements)
# ============================================

# JWT Secret (CHANGEZ cette valeur !)
JWT_SECRET=your_super_secret_jwt_key_here_change_me

# Base de données MongoDB
MONGO_URI=mongodb://mongo:27017/topbudget

# Port du backend
PORT=5001

# ============================================
# Mongo Express (outils de développement)
# ============================================
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin_password

# ============================================
# Instructions d'usage
# ============================================
# 
# DÉVELOPPEMENT:
# 1. Copiez ce fichier: cp .env.example .env
# 2. Gardez les valeurs par défaut pour commencer
# 3. Lancez: docker-compose -f docker-compose.yml -f docker/docker-compose.dev.yml up
#
# PRODUCTION:
# 1. Créez vos Docker secrets: voir documentation
# 2. Utilisez: docker-compose -f docker-compose.yml -f docker/docker-compose.prod.yml up -d
#
# TESTS:
# 1. Lancez: docker-compose -f docker-compose.yml -f docker/docker-compose.test.yml up --abort-on-container-exit