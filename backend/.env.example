# ============================================
# Variables d'environnement Backend - TopBudget
# ============================================
# Copiez ce fichier vers .env et adaptez les valeurs à votre environnement

# ============================================
# ENVIRONNEMENT
# ============================================
NODE_ENV=development
PORT=5001
LOG_LEVEL=debug

# ============================================
# BASE DE DONNÉES MONGODB
# ============================================
# URI complète de connexion MongoDB
MONGO_URI=mongodb://localhost:27017/topbudget_dev

# Alternative pour la production avec authentification
# MONGO_URI=mongodb://username:password@host:port/database?authSource=admin

# Configuration MongoDB (optionnel)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=topbudget_dev
MONGO_USERNAME=
MONGO_PASSWORD=

# ============================================
# SÉCURITÉ JWT
# ============================================
# Clé secrète pour signer les tokens JWT (OBLIGATOIRE EN PRODUCTION)
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# Durée de vie des tokens
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# SÉCURITÉ CORS
# ============================================
# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Credentials CORS
CORS_CREDENTIALS=true

# ============================================
# CONFIGURATION API
# ============================================
# Préfixe de l'API
API_PREFIX=/api

# Limite de taille des requêtes
BODY_LIMIT=10mb

# Rate limiting (requêtes par minute)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# ============================================
# FICHIERS ET UPLOADS
# ============================================
# Dossier pour les uploads
UPLOAD_DIR=./public/uploads

# Taille max des fichiers (en MB)
MAX_FILE_SIZE=5

# Types de fichiers autorisés (séparés par des virgules)
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf

# ============================================
# EMAIL (pour notifications)
# ============================================
# Configuration SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Expéditeur par défaut
EMAIL_FROM=noreply@topbudget.com
EMAIL_FROM_NAME=TopBudget

# ============================================
# MONITORING ET LOGS
# ============================================
# Activation des logs détaillés
DEBUG=app:*

# Sentry pour le monitoring d'erreurs (optionnel)
SENTRY_DSN=

# Health check configuration
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# ============================================
# REDIS (pour le cache - optionnel)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# SECRETS MANAGEMENT (PRODUCTION)
# ============================================
# En production, utilisez Docker Secrets plutôt que des variables d'environnement
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# MONGO_URI_FILE=/run/secrets/mongo_uri

# ============================================
# VARIABLES SPÉCIFIQUES À L'ENVIRONNEMENT
# ============================================

# DÉVELOPPEMENT
# NODE_ENV=development
# LOG_LEVEL=debug
# DEBUG=app:*

# TEST
# NODE_ENV=test
# MONGO_URI=mongodb://localhost:27017/topbudget_test
# JWT_SECRET=test_jwt_secret_not_secure

# PRODUCTION
# NODE_ENV=production
# LOG_LEVEL=info
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# MONGO_URI_FILE=/run/secrets/mongo_uri